{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated GramaMitra user account profile",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the account owner",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fullName": {
          "type": "string",
          "description": "Full name of the user",
          "minLength": 1,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified email address",
          "maxLength": 150
        },
        "phone": {
          "type": "string",
          "description": "Optional 10-digit Indian mobile number",
          "maxLength": 10,
          "pattern": "^[6-9][0-9]{9}$"
        },
        "district": {
          "type": "string",
          "description": "Default Tamil Nadu district",
          "maxLength": 60
        },
        "role": {
          "type": "string",
          "description": "Account role fixed to citizen on self-registration",
          "enum": ["citizen"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": ["uid", "fullName", "email", "role", "createdAt", "updatedAt"]
    },
    "CustomerRecord": {
      "title": "CustomerRecord",
      "description": "Private citizen or customer profile saved by the authenticated user for scheme eligibility tracking",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Customer document identifier",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "UID of the user who owns this customer record",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fullName": {
          "type": "string",
          "description": "Customer full name",
          "minLength": 2,
          "maxLength": 100
        },
        "phone": {
          "type": "string",
          "description": "10-digit Indian mobile number",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[6-9][0-9]{9}$"
        },
        "age": {
          "type": "number",
          "description": "Customer age in years (1-120)"
        },
        "gender": {
          "type": "string",
          "description": "Applicant gender",
          "enum": ["male", "female", "other"]
        },
        "occupation": {
          "type": "string",
          "description": "Primary occupation category",
          "enum": ["farmer", "elderly", "student", "shopkeeper", "homemaker", "artisan", "fisher", "worker"]
        },
        "annualIncome": {
          "type": "number",
          "description": "Annual household income in INR"
        },
        "hasLand": {
          "type": "boolean",
          "description": "Whether customer owns cultivable land"
        },
        "landAcres": {
          "type": "number",
          "description": "Land area in acres"
        },
        "district": {
          "type": "string",
          "description": "Tamil Nadu district",
          "minLength": 2,
          "maxLength": 60
        },
        "village": {
          "type": "string",
          "description": "Village or panchayat name",
          "minLength": 1,
          "maxLength": 80
        },
        "notes": {
          "type": "string",
          "description": "Optional notes on documents or scheme status",
          "maxLength": 400
        },
        "eligibleSchemeCount": {
          "type": "number",
          "description": "Matched scheme count computed from rules"
        },
        "status": {
          "type": "string",
          "description": "Application tracking status",
          "enum": ["active", "applied", "completed"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": [
        "id",
        "ownerId",
        "fullName",
        "phone",
        "age",
        "gender",
        "occupation",
        "annualIncome",
        "hasLand",
        "landAcres",
        "district",
        "village",
        "eligibleSchemeCount",
        "status",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Stores authenticated user account metadata isolated to the owner UID"
    },
    "/users/{userId}/customers/{customerId}": {
      "schema": { "$ref": "#/entities/CustomerRecord" },
      "description": "Stores private customer/citizen records added by the authenticated user"
    }
  }
}
